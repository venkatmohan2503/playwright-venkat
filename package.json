{
  "name": "playwright-shopping-framework",
  "version": "1.0.0",
  "description": "Simple Playwright E2E framework for the Rahul Shetty Academy shopping app",
  "scripts": {
    "register": "playwright test tests/register.spec.js --grep @registerOnce",
    "test": "playwright test --grep-invert @registerOnce",
    "test:headed": "playwright test --grep-invert @registerOnce --headed",
    "report": "playwright show-report",
    "heal": "node utils/healer/healSelectors.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/identity": "^4.13.1",
    "@azure/playwright": "^1.1.6",
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.9.0"
  }
}
